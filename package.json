{
  "name": "agent-workflow-viewer",
  "version": "0.2.0-dev.0",
  "description": "A DeepSeek Harness plugin for inspecting live tool calls, failures, and subagent activity.",
  "type": "module",
  "scripts": { "test": "node --test test/viewer.test.js" },
  "license": "MIT",
  "author": "hgognav233-netizen",
  "keywords": ["dsh-plugin", "visualization", "workflow", "subagent", "observability"],
  "repository": { "type": "git", "url": "git+https://github.com/hgognav233-netizen/agent-workflow-viewer.git" },
  "homepage": "https://github.com/hgognav233-netizen/agent-workflow-viewer",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README.zh-CN.md", "CHANGELOG.md", "docs/detached-window.md", "preview.png"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
